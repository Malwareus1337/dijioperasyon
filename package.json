{
  "name": "dijipin-operasyon-takip",
  "version": "1.0.0",
  "description": "Dijipin Operasyon Personel İş, Vardiya ve Performans Takip Sistemi",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.dijipin.operasyontakip",
    "productName": "Dijipin Operasyon Takip",
    "asar": true,
    "afterPack": "./after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "firebase-sync.js",
      "stock-scanner.js",
      "updater.js",
      "package.json",
      "public/**/*",
      "data/**/*",
      "firebase-config.json"
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Dijipin-Operasyon-Takip.exe"
    }
  }
}
